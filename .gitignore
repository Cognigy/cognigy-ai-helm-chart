# OSX leaves these everywhere on SMB shares
._*

# OSX trash
.DS_Store

# Files generated by JetBrains IDEs, e.g. IntelliJ IDEA
.idea/
*.iml

# Vscode files
.vscode

# Emacs save files
*~
\#*\#
.\#*

# Vim-related files
[._]*.s[a-w][a-z]
[._]s[a-w][a-z]
*.un~
Session.vim
.netrwhist

# Chart dependencies
**/charts/*.tgz
values-local.yaml
values-local.out.yaml
Chart.lock

.history

# ignore files we might create for local development
ui.test/
minica-key.pem
minica.pem
_local_dev/

# ignore generated public / private-keypairs
es256-private.pem
es256-public.pem

.serena/

# oh-my-claudecode — per-session, per-user tooling state (agent replay logs, HUD
# cache, session tracking). Regenerable and machine-local; the replay logs can
# contain conversation transcript. No leading slash, so this also catches nested
# state roots the tooling creates when a command runs from a subdirectory.
.omc/

.claude/worktrees/
